{
  "name": "pi-ticket-runner",
  "version": "0.1.2",
  "description": "A Pi extension that runs Matt Pocock-skill tickets one by one, each in its own fresh session — so your main context never overflows.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Stoyan Krastev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skkdevcraft/pi-ticket-runner.git"
  },
  "homepage": "https://github.com/skkdevcraft/pi-ticket-runner#readme",
  "bugs": {
    "url": "https://github.com/skkdevcraft/pi-ticket-runner/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/"
  }
}
